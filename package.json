{
  "name": "earlyher-kiosk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:browser": "node scripts/verify-browser.mjs",
    "audio:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-loader.mjs scripts/audio-status.mjs",
    "audio:warm": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-loader.mjs scripts/audio-warm.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.0",
    "qrcode-generator": "1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
