# Copy to .env.local and adjust. Every NEXT_PUBLIC_ value is PUBLIC: it is built into the
# browser bundle. Secrets go only in the server-only section at the end, never in NEXT_PUBLIC_ values.

# "mock" (default) runs with no backend. "http" calls the Python service below.
NEXT_PUBLIC_API_MODE=mock
# Base URL of the Python backend, without a trailing slash. Used only when API_MODE=http.
NEXT_PUBLIC_API_BASE_URL=

# Inactivity: seconds before the warning, then seconds the warning stays up.
NEXT_PUBLIC_INACTIVITY_TIMEOUT_SECONDS=120
NEXT_PUBLIC_INACTIVITY_WARNING_SECONDS=30

# Public https page printed QR codes may link to. Leave empty until a real page exists.
NEXT_PUBLIC_PUBLIC_INFO_URL=

# "page" for normal printers, "thermal-80" for an 80mm receipt printer.
NEXT_PUBLIC_PRINT_LAYOUT=page

# Approved telemedicine provider for "Talk to a doctor online". Leave both empty until a
# provider has been approved; the app then says online consultations are not available.
# The URL must be https.
NEXT_PUBLIC_TELEMEDICINE_URL=
NEXT_PUBLIC_TELEMEDICINE_NAME=

# Local emergency number for urgent guidance, digits only (optional leading +). Leave empty
# until the number for the deployment area is verified: the app then says "your local
# emergency number" without naming one.
NEXT_PUBLIC_EMERGENCY_NUMBER=

# Published privacy policy (https). Empty links the consent screen to the in-app /privacy page.
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# "off" hides "Save my progress on this device". Recommended for shared kiosks.
NEXT_PUBLIC_DEVICE_SAVE=

# Map tiles. Empty uses tile.openstreetmap.org (light use only, attribution required,
# no bulk/offline caching, no service guarantee). Use a contracted provider for kiosks.
# If you change the URL, set the attribution that provider requires (HTML allowed).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Interface-test fixture and demo-state switcher. Default: on in `next dev`, off in builds.
# Set to "true" to show them in a production build for an internal review.
NEXT_PUBLIC_SHOW_DEV_FIXTURES=

# --- Server-only settings (never prefix these with NEXT_PUBLIC_) ---------------------
# Nigeria Health Facility Registry API key, requested at
# https://www.hfr.fmohconnect.gov.ng/developers. Used only by lib/facilities/sources/hfr.ts
# on the server. Not yet wired into the finder: field mapping awaits the API documentation.
HFR_API_KEY=
# Optional override; defaults to https://backend.hfr.fmohconnect.gov.ng/api/v1
HFR_API_BASE_URL=

# Spoken audio (Listen). Server-only: never prefix with NEXT_PUBLIC_.
# Reviewed recordings in public/audio/<lang>/ always play first (see content/yo/audio-map.ts).
# Without a provider, Yoruba Listen plays recordings only, or a Yoruba voice built into the
# device if it has one, and otherwise says Yoruba audio is unavailable.
# "spitch" is the only provider wired in: its documentation lists Yoruba ("yo").
SPEECH_PROVIDER=
SPITCH_API_KEY=
# Yoruba voice: sade or funmi (feminine), segun or femi (masculine). Default: sade.
SPITCH_VOICE_YO=
# Languages that use the provider (comma-separated). Default: yo. Add "en" and set
# SPITCH_VOICE_EN (e.g. lucy) to also generate English speech.
SPEECH_LANGUAGES=
SPITCH_VOICE_EN=
# Where generated clips are cached (default .speech-cache); "off" keeps them in memory only.
# Delete this folder to regenerate every clip. Edited wording is regenerated automatically.
SPEECH_CACHE_DIR=
# Abuse limits per server instance (defaults 120, 30 and 3000).
SPEECH_REQUESTS_PER_MINUTE=
SPEECH_GENERATIONS_PER_MINUTE=
SPEECH_GENERATIONS_PER_DAY=
