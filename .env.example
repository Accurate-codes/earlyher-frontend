# Copy to .env.local and adjust. Every value here is PUBLIC: it is built into the
# browser bundle. Never put API keys, SMS credentials or other secrets in this file.

# "mock" (default) runs with no backend. "http" calls the Python service below.
NEXT_PUBLIC_API_MODE=mock
# Base URL of the Python backend, without a trailing slash. Used only when API_MODE=http.
NEXT_PUBLIC_API_BASE_URL=

# Inactivity: seconds before the warning, then seconds the warning stays up.
NEXT_PUBLIC_INACTIVITY_TIMEOUT_SECONDS=120
NEXT_PUBLIC_INACTIVITY_WARNING_SECONDS=30

# Longest optional voice note, in seconds.
NEXT_PUBLIC_MAX_RECORDING_SECONDS=30

# Public https page printed QR codes may link to. Leave empty until a real page exists.
NEXT_PUBLIC_PUBLIC_INFO_URL=

# "page" for normal printers, "thermal-80" for an 80mm receipt printer.
NEXT_PUBLIC_PRINT_LAYOUT=page

# Interface-test fixture and demo-state switcher. Default: on in `next dev`, off in builds.
# Set to "true" to show them in a production build for an internal review.
NEXT_PUBLIC_SHOW_DEV_FIXTURES=
